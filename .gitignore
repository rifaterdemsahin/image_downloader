# Downloaded images are ignored; only the README is tracked
downloads/**
!downloads/README.md
output/**
outputs/**

# Never commit generated HTML galleries
*.html

# Never commit image files anywhere in the repo
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.avif
*.bmp
*.tiff
*.tif
*.ico
*.svg
*.heic
*.heif
*.raw
*.cr2
*.nef
